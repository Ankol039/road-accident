# =============================================================================
# RoadReport Admin Portal - environment variables
# Copy this file to `.env` to use the configured Firebase web app.
#
# Where to get them:
#   Firebase console -> Project settings (gear) -> General -> Your apps
#   If there is no Web app yet: click the </> "Add app" button and register one.
#   The config block is shown under "SDK setup and configuration".
#
# These values are NOT secrets (they are visible in every web app), but we keep
# them in .env so each environment can point at a different Firebase project.
# =============================================================================

# Firebase Web SDK config for roadreport-402a6 (public client identifiers).
VITE_FIREBASE_API_KEY=AIzaSyCk5hAS-MyKVjQegjpJG-KdZwY9tBXu3A8
VITE_FIREBASE_AUTH_DOMAIN=roadreport-402a6.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=roadreport-402a6
VITE_FIREBASE_STORAGE_BUCKET=roadreport-402a6.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=481949702737
VITE_FIREBASE_APP_ID=1:481949702737:web:6dc5049dfeb19853113670

# Where the React app is hosted (used only for display / absolute links).
VITE_APP_NAME=RoadReport
VITE_APP_ENV=development
