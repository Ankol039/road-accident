# =============================================================================
# RoadReport Admin Portal - environment variables
# Copy this file to `.env` and fill in the real values.
#
# Where to get them:
#   Firebase console -> Project settings (gear) -> General -> Your apps
#   If there is no Web app yet: click the </> "Add app" button and register one.
#   The config block is shown under "SDK setup and configuration".
#
# These values are NOT secrets (they are visible in every web app), but we keep
# them in .env so each environment can point at a different Firebase project.
# =============================================================================

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=group3finalproj-9761b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=group3finalproj-9761b
VITE_FIREBASE_STORAGE_BUCKET=group3finalproj-9761b.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Where the React app is hosted (used only for display / absolute links).
VITE_APP_NAME=RoadReport
VITE_APP_ENV=development
