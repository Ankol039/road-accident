# Admin website. The pages are PHP files (index.php, login.php, admin.php, ...).

# Open index.php when only the folder is typed (https://your-site.com/)
DirectoryIndex index.php index.html

# Old links and bookmarks to the .html pages (login.html, report.html?id=5, ...)
# go to the matching .php page. The ?id=... part is kept.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # The officer portal moved to the mobile app; old links go to the landing page
    RewriteRule ^officer\.(php|html)$ index.php [R=302,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} ^(.*/[a-z0-9-]+)\.html$
    RewriteRule ^[a-z0-9-]+\.html$ %1.php [R=301,L]
</IfModule>

Options -Indexes
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<FilesMatch "(?i)\.(zip|sql|bak|log|env)$">
    Require all denied
</FilesMatch>
