ight: 500; }\n.notif-row.is-unread { border-left-color: var(--acc); background: rgba(228, 87, 46, 0.14); color: var(--ink); }\n.notif-row.is-unread strong { font-weight: 750; }\n.notif-row:focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }\n\n@media (prefers-reduced-motion: reduce) {\n  * { scroll-behavior: auto !important; transition: none !important; animation: none !important; }\n}\n\n/* ---------- Added for the plain HTML version ---------- */\n.skip-link {\n  position: absolute;\n  left: -9999px;\n  top: 0;\n  z-index: 1000;\n  background: var(--lane);\n  color: var(--asphalt);\n  padding: 0.5rem 1rem;\n  font-weight: 800;\n}\n.skip-link:focus { left: 0.5rem; top: 0.5rem; }\n.reporter-shell { min-height: 100vh; }\n.chart-box { position: relative; height: 260px; }\n.legend-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 0.3rem; vertical-align: middle; }\n.panel.border-warning { border: 2px solid var(--lane); background: rgba(242, 183, 5, 0.08); }\n.modal-content { border-radius: 10px; background: var(--asphalt-2); color: var(--ink); }\n.modal-header { border-top: 6px solid var(--acc); border-radius: 10px 10px 0 0; border-bottom-color: var(--line); }\n.modal-footer { border-top-color: var(--line); }\n.modal-content .btn-close { filter: invert(1) grayscale(1) brightness(2); }\ndetails > summary { cursor: pointer; color: var(--acc); }\n.leaflet-popup-content { font-family: var(--bs-body-font-family); line-height: 1.45; }\n.alert-danger { --bs-alert-color: #f39a95; --bs-alert-bg: rgba(200, 50, 43, 0.15); --bs-alert-border-color: rgba(200, 50, 43, 0.4); }\n.alert-success { --bs-alert-color: #6fe0a1; --bs-alert-bg: rgba(60, 207, 122, 0.12); --bs-alert-border-color: rgba(60, 207, 122, 0.35); }\n.alert-warning { --bs-alert-color: #f5c518; --bs-alert-bg: rgba(242, 183, 5, 0.12); --bs-alert-border-color: rgba(242, 183, 5, 0.35); }\n.alert-info { --bs-alert-color: #86d6ea; --bs-alert-bg: rgba(60, 180, 210, 0.12);