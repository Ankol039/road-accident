rd goes quiet: no glow, dimmer ring and number. */\n.staff-main .rr-dashboard-stats .stat-card[data-level=\"none\"]::after {\n  box-shadow: none;\n  opacity: 0.6;\n}\n.staff-main .rr-dashboard-stats .stat-card[data-level=\"none\"] .stat-value {\n  color: var(--rr-muted);\n}\n\n/* Colour is not the only signal: the level is also exposed as hidden text. */\n.rr-dashboard-level-text {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n.staff-main .rr-dashboard-note {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  margin: 0.25rem 0 0.5rem;\n  font-size: 0.85rem;\n  color: var(--rr-muted);\n}\n\n.staff-main .rr-dashboard-note::before {\n  content: \"\";\n  flex: none;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--rr-amber);\n  box-shadow: 0 0 10px var(--rr-amber);\n}\n\n\n.staff-main .panel {\n  position: relative;\n  overflow: hidden;\n  padding: 20px 22px 22px;\n  border: 1px solid var(--rr-line);\n  border-radius: 22px;\n  background: linear-gradient(180deg, #171d20 0%, #12171a 100%);\n  box-shadow: 0 22px 44px -28px rgba(0, 0, 0, 0.8);\n  color: var(--rr-text);\n}\n\n.staff-main .panel.p-0 {\n  padding: 0;\n}\n\n.rr-dashboard-page .panel h2.h6 {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  margin-bottom: 1rem;\n  font-family: var(--rr-display);\n  font-size: 1.15rem;\n  font-weight: 600;\n  letter-spacing: 0.005em;\n  color: var(--rr-text);\n}\n\n.rr-dashboard-page .panel h2.h6::before {\n  content: \"\";\n  flex: none;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--rr-orange);\n  box-shadow: 0 0 10px var(--rr-orange);\n}\n\n/* Equal-height chart tiles in the 2-up grid. */\n.rr-dashboard-charts > [class*=\"col-\"] {\n  display: flex;\n}\n\n.rr-dashboard-charts > [class*=\"col-\"] > .panel {\n  width: 100%;\n}\n\n.rr-dashboard-page .chart-box {\n  display: flex;\n  align-items: center;\n  justify-content: 